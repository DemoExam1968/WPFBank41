<Window x:Class="WPFCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFCalculator"
        mc:Ignorable="d"
        Title="Калькулятор" Height="400" Width="700" Background="#FFEAD9ED"
        MinWidth="400" MinHeight="450">
    <Grid>
        <!--Разбивка окна на ячейки-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <!--Разложить по ячейкам компоненты-->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Введите первое число" FontSize="20"
                   VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBox x:Name="tbFirst" Grid.Row="1" Grid.Column="0" FontSize="20"
                 Margin="20 50"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Введите второе число" FontSize="20"
                   VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBox x:Name="tbSecord" Grid.Row="1" Grid.Column="2" FontSize="20"
                 Margin="20 50"/>
        <UniformGrid Grid.Row="1" Grid.Column="1" Background="Aqua" Columns="3" Rows="2">
            <Button x:Name="btnAdd" Content="+" FontSize="50" Click="btnDiv_Click"/>
            <Button x:Name="btnSub" Content="-" FontSize="50" Click="btnDiv_Click"/>
            <Button x:Name="btnMul" Content="*" FontSize="50" Click="btnDiv_Click"/>
            <Button x:Name="btnDiv" Content="/" FontSize="50" Click="btnDiv_Click"/>
            <Button x:Name="btnXY" Content="x^y" FontSize="30" Click="btnDiv_Click" />
            <Button x:Name="btnClaer" Content="C" FontSize="30" Click="btnClaer_Click" />
        </UniformGrid>
        <TextBlock x:Name="tbResult" Grid.Row="2" Grid.Column="1" Text="Ответ" FontSize="20"
                   VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0 30"/>
    </Grid>
</Window>
